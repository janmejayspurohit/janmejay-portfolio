---
import { getImage } from 'astro:assets';
import sharp from 'sharp';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import portrait from '../assets/portrait.jpg';
import { site, ageOn } from '../data/site';
import { hobbies } from '../data/hobbies';

const path = [
  { yr: '2017', org: 'MindIQ' },
  { yr: '2018', org: 'EzPG' },
  { yr: '2019', org: 'Box8' },
  { yr: '2019', org: 'Tesark' },
  { yr: '2022', org: 'IU' },
  { yr: '2024', org: 'T-Mobile', current: true },
];
// The portrait is the page's largest image, so it is treated as critical:
// preloaded from <head>, decoded with the first paint, and backed by a tiny
// blurred copy inlined into the page so the tile is never empty.
const PHOTO_SIZES = '(max-width: 560px) 100vw, (max-width: 1023px) 50vw, 25vw';
const WIDTHS = [320, 480, 640, 800];
// AVIF first (about 40% smaller), WebP for browsers without it.
const photoAvif = await getImage({ src: portrait, widths: WIDTHS, sizes: PHOTO_SIZES, quality: 55, format: 'avif' });
const photo = await getImage({ src: portrait, widths: WIDTHS, sizes: PHOTO_SIZES, quality: 72, format: 'webp' });
// read from the source tree: at build time this file runs from the output folder
const blur = await sharp(join(process.cwd(), 'src/assets/portrait.jpg'))
  .resize(24)
  .webp({ quality: 40 })
  .toBuffer();
const blurUrl = `data:image/webp;base64,${blur.toString('base64')}`;

const stack = ['TypeScript', 'Angular', 'Svelte', 'Astro', 'React', 'Node.js', 'Spring Boot', 'PostgreSQL'];
---
<Base
  title="Janmejay S Purohit | Full Stack Software Engineer"
  description="Janmejay S Purohit: full stack software engineer and Lead Developer at T-Mobile, building fast, accessible web products with Angular, Svelte, Astro and Node.js."
>
  <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={photoAvif.srcSet.attribute} imagesizes={PHOTO_SIZES} fetchpriority="high" />
  <div class="wrap home">
    <div class="bento">
      <section class="tile t-hero" aria-labelledby="hero-name">
        <span class="label"><span class="prompt">~/</span>janmejay · full stack software engineer</span>
        <h1 id="hero-name">Janmejay S&nbsp;Purohit</h1>
        <p class="lede">
          Full stack software engineer and graphic designer. I build fast, accessible web products end to end, from
          Angular, Svelte and Astro front ends to the Node.js services behind them.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href="/experience">See my work <Icon name="lucide:arrow-up-right" size={16} /></a>
          <a class="btn btn-ghost" href="/contact">Get in touch</a>
        </div>
      </section>

      <div class="tile t-photo" style={`background-image:url(${blurUrl})`}>
        <picture>
          <source type="image/avif" srcset={photoAvif.srcSet.attribute} sizes={PHOTO_SIZES} />
          <img
            src={photo.src}
            srcset={photo.srcSet.attribute}
            sizes={PHOTO_SIZES}
            width={portrait.width}
            height={portrait.height}
            alt="Janmejay S Purohit in front of the U.S. Capitol"
            loading="eager"
            decoding="sync"
            fetchpriority="high"
          />
        </picture>
      </div>

      <a class="tile t-now" href="/experience">
        <span class="label status"><span class="status-dot"></span>Now</span>
        <span class="big">Lead Developer</span>
        <span class="small">T-Mobile · since Dec 2024</span>
        <span class="tile-link-arrow"><Icon name="lucide:arrow-up-right" /></span>
      </a>

      <a class="tile t-edu" href="/resume">
        <span class="label">Studied</span>
        <span class="big">M.S. Computer Science</span>
        <span class="small">Indiana University Bloomington · GPA 3.82</span>
        <span class="tile-link-arrow"><Icon name="lucide:arrow-up-right" /></span>
      </a>

      <section class="tile t-path" aria-label="Career path">
        <span class="label">Path</span>
        <ol class="path">
          {path.map((p) => (
            <li class={p.current ? 'current' : undefined}>
              <span class="yr">{p.yr}</span>
              <span class="org">{p.org}</span>
            </li>
          ))}
        </ol>
      </section>

      <div class="tile t-lang">
        <span class="label">Speaks</span>
        <span class="scripts" lang="mul">English · ಕನ್ನಡ<br />हिंदी · 日本語</span>
        <span class="small">JLPT N3 certified</span>
      </div>

      <div class="tile t-count">
        <span class="label">Visitors</span>
        <span class="count" data-visitor-count>—</span>
        <span class="small">page visits so far</span>
      </div>

      <div class="tile t-stack">
        <span class="label">Works in</span>
        <ul class="chips">
          {stack.map((s) => <li class="chip">{s}</li>)}
        </ul>
      </div>

      <a class="tile t-cv" href={site.resume} target="_blank" rel="noopener">
        <span class="label">Resume</span>
        <span class="big">v5 · PDF</span>
        <span class="small">One page. Opens in a new tab.</span>
        <span class="tile-link-arrow"><Icon name="lucide:file-text" /></span>
      </a>
    </div>

    <section class="section reveal" id="about" aria-labelledby="about-title">
      <div class="section-head"><h2 id="about-title">About Janmejay</h2></div>
      <div class="about-grid">
        <div class="about-text">
          <p>
            I’m Janmejay, a Full Stack Developer and Graphic Designer. I enjoy building things for the web and solving
            complex problems with clean, maintainable code.
          </p>
          <p>
            Feel free to browse around — if you have any questions or suggestions, don’t hesitate to reach out via the{' '}
            <a href="/contact">contact section</a>.
          </p>
        </div>
        <ul class="meta-list">
          <li><Icon name="lucide:cake" /><span class="k">Age</span><span class="v" data-age>{ageOn(new Date())}</span></li>
          <li><Icon name="lucide:languages" /><span class="k">Languages</span><span class="v">{site.languages.join(', ')}</span></li>
          <li><Icon name="lucide:map-pin" /><span class="k">Location</span><span class="v">{site.location}</span></li>
          <li><Icon name="mdi:github" /><span class="k">GitHub</span><span class="v"><a href={site.github} target="_blank" rel="noopener noreferrer">github.com/janmejayspurohit</a></span></li>
          <li><Icon name="mdi:linkedin" /><span class="k">LinkedIn</span><span class="v"><a href={site.linkedin} target="_blank" rel="noopener noreferrer">linkedin.com/in/jsp324</a></span></li>
        </ul>
      </div>
    </section>

    <section class="section reveal" id="hobbies" aria-labelledby="hobbies-title">
      <div class="section-head"><h2 id="hobbies-title">Hobbies &amp; Interests</h2></div>
      <ul class="hobbies">
        {hobbies.map((h) => (
          <li><Icon name={h.icon} />{h.label}</li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<script>
  import { ageOn } from '../data/site';
  // The build bakes in the age at build time; refresh it so it never goes stale.
  const el = document.querySelector('[data-age]');
  if (el) el.textContent = String(ageOn(new Date()));

  // Soft spotlight that follows the pointer across bento tiles (mouse only).
  if (window.matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
    document.querySelectorAll<HTMLElement>('.bento .tile').forEach((tile) => {
      tile.addEventListener('pointermove', (e) => {
        const r = tile.getBoundingClientRect();
        tile.style.setProperty('--mx', `${e.clientX - r.left}px`);
        tile.style.setProperty('--my', `${e.clientY - r.top}px`);
      });
    });
  }
</script>
