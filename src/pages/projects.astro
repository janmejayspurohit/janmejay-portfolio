---
import Split from '../layouts/Split.astro';
import { projects } from '../data/projects';
---
<Split
  title="Janmejay S Purohit - Projects"
  description="Portfolio projects by Janmejay S Purohit including web apps, Android development, and computer vision work."
  eyebrow="~/projects"
  heading="Projects"
  intro="Builds from university and hackathons: payments, computer vision, VR and Android. More recent work is on its way."
>
  <div class="cards">
    {projects.map((p) => (
      <article class="card reveal">
        <h2 class="h3" style="font-size:1.05rem">{p.title}</h2>
        <p>{p.desc}</p>
        <ul class="chips">
          {p.tech.map((t) => <li class="chip">{t}</li>)}
        </ul>
      </article>
    ))}
  </div>
</Split>
