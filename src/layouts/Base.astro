---
import '@fontsource-variable/geist';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { nav, site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Keep a page out of search results (used by the 404 page). */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(path, site.url).href;
const ogImage = new URL(site.ogImage, site.url).href;
const isHome = path === '/';
const crumb = nav.find((n) => n.href === path)?.label;

// Structured data: who the site is about, the site itself, this page, and where it sits.
const personId = `${site.url}/#person`;
const websiteId = `${site.url}/#website`;
const graph: Record<string, unknown>[] = [
  {
    '@type': 'Person',
    '@id': personId,
    name: site.name,
    url: site.url,
    image: new URL(site.portraitUrl, site.url).href,
    jobTitle: site.role,
    description: 'Full stack software engineer and graphic designer. Lead Developer at T-Mobile.',
    email: site.email,
    sameAs: [site.linkedin, site.github],
    address: { '@type': 'PostalAddress', addressCountry: 'US' },
    alumniOf: [
      { '@type': 'CollegeOrUniversity', name: 'Indiana University Bloomington', url: 'https://bloomington.iu.edu/' },
      { '@type': 'CollegeOrUniversity', name: 'Dayananda Sagar University' },
    ],
    knowsAbout: ['TypeScript', 'JavaScript', 'Svelte', 'Astro', 'React', 'Angular', 'Node.js', 'Web performance', 'Web accessibility'],
    knowsLanguage: ['English', 'Kannada', 'Hindi', 'Japanese'],
  },
  { '@type': 'WebSite', '@id': websiteId, url: site.url, name: site.name, inLanguage: 'en', publisher: { '@id': personId } },
  {
    '@type': isHome ? 'ProfilePage' : 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    inLanguage: 'en',
    isPartOf: { '@id': websiteId },
    about: { '@id': personId },
    ...(isHome ? { mainEntity: { '@id': personId } } : {}),
  },
];
if (!isHome && crumb) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site.url).href },
      { '@type': 'ListItem', position: 2, name: crumb, item: canonical },
    ],
  });
}
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          document.documentElement.setAttribute('data-theme', t === 'light' || t === 'dark' ? t : 'dark');
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#010126" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/favicon-96.png" sizes="96x96" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content={isHome ? 'profile' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.role}`} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${site.name}, ${site.role}`} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <BackToTop />
  </body>
</html>
