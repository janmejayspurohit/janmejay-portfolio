---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro: string;
}

const { title, description, eyebrow, heading, intro } = Astro.props;
---
<Base title={title} description={description}>
  <div class="wrap">
    <div class="split">
      <aside class="split-aside">
        <span class="label"><span class="prompt">›</span> {eyebrow}</span>
        <h1>{heading}</h1>
        <p class="intro">{intro}</p>
        <slot name="aside" />
      </aside>
      <div class="split-main">
        <slot />
      </div>
    </div>
  </div>
</Base>
