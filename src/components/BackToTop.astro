---
import Icon from './Icon.astro';
---
<a href="#main" class="to-top" data-to-top aria-label="Back to top"><Icon name="lucide:arrow-up" /></a>

<script>
  const btn = document.querySelector<HTMLAnchorElement>('[data-to-top]');
  const update = () => btn?.classList.toggle('is-visible', window.scrollY > 600);
  window.addEventListener('scroll', update, { passive: true });
  update();
  btn?.addEventListener('click', (e) => {
    e.preventDefault();
    const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: smooth ? 'smooth' : 'auto' });
  });
</script>
