---
---

<p class="form-note">Use this form to send me a message. Your submission is delivered to my Discord inbox.</p>
<form class="form" id="contact-form" novalidate>
  <div class="form-row">
    <div class="field">
      <label for="name">Name <span class="req" aria-hidden="true">*</span></label>
      <input id="name" name="name" type="text" placeholder="Your full name" maxlength="120" required />
    </div>
    <div class="field">
      <label for="email">Email <span class="req" aria-hidden="true">*</span></label>
      <input id="email" name="email" type="email" placeholder="you@example.com" maxlength="254" required />
      <p id="email-error" class="field-error" role="alert" hidden></p>
    </div>
  </div>
  <div class="field">
    <label for="subject">Subject <span class="req" aria-hidden="true">*</span></label>
    <input id="subject" name="subject" type="text" placeholder="What is this about?" maxlength="300" required />
  </div>
  <div class="field">
    <label for="message">Message <span class="req" aria-hidden="true">*</span></label>
    <textarea id="message" name="message" rows="6" placeholder="Write your message here..." maxlength="1000" required></textarea>
    <p id="message-error" class="field-error" role="alert" hidden></p>
  </div>
  <!-- Bot trap: real visitors never see or reach this field; form-filling bots fill it. -->
  <div class="hp" aria-hidden="true">
    <label for="company-website">Leave this field empty</label>
    <input id="company-website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <div class="form-actions">
    <button type="submit" class="btn btn-primary" disabled>Send Message</button>
    <p class="form-status" aria-live="polite"></p>
  </div>
</form>

<script>
// Plain JavaScript version for Astro compatibility
type FormValues = {
  name: string;
  email: string;
  subject: string;
  message: string;
};

const INITIAL_FORM: FormValues = {
  name: '',
  email: '',
  subject: '',
  message: '',
};

const CONTACT_ENDPOINT = import.meta.env.VITE_CONTACT_ENDPOINT || '';
// A person needs a few seconds to type four fields; a script submits at once.
const MIN_FILL_MS = 3000;
const loadedAt = Date.now();
const MIN_MESSAGE_LENGTH = 5;
const EMAIL_REGEX = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

/** 
 * @param {string | null | undefined} text 
 * @param {number} max 
 * @returns {string}
 */
function clamp(text: string | null | undefined, max: number): string {
  if (!text) return '';
  const trimmed = text.trim();
  if (trimmed.length <= max) return trimmed;
  return `${trimmed.slice(0, max)}...`;
}

/** 
 * @param {FormValues} formValues 
 * @returns {Object}
 */
function buildDiscordPayload({ name, email, subject, message }: FormValues) {
  return {
    username: 'Portfolio Bot',
    allowed_mentions: { parse: [] },
    embeds: [
      {
        title: 'Contact Request',
        color: 3658935,
        fields: [
          { name: 'Name', value: clamp(name, 120) || 'Not provided', inline: true },
          { name: 'Email', value: clamp(email, 254) || 'Not provided', inline: true },
          { name: 'Subject', value: clamp(subject, 300) || 'No subject', inline: false },
          { name: 'Message', value: clamp(message, 1000) || 'No message', inline: false },
        ],
        footer: {
          text: 'Sent from janmejay.info/contact',
        },
        timestamp: new Date().toISOString(),
      },
    ],
  };
}

// This will be executed on the client side
const initContactForm = () => {
  let form = INITIAL_FORM;
  let status: 'idle' | 'loading' | 'success' | 'error' = 'idle';
  let feedback = '';
  let emailTouched = false;
  let messageTouched = false;
  
  const updateForm = (name: string, value: string) => {
    form = { ...form, [name]: value };
    updateSubmitButton();
  };

  const validateEmail = () => {
    const emailValue = form.email.trim();
    return emailValue.length > 0 && EMAIL_REGEX.test(emailValue);
  };

  const validateMessage = () => {
    const messageLength = form.message.trim().length;
    return messageLength >= MIN_MESSAGE_LENGTH;
  };

  const updateSubmitButton = () => {
    const formElement = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!formElement) return;
    
    const isEmailInvalid = !validateEmail();
    const isMessageTooShort = !validateMessage();
    const isSubmitDisabled = 
      status === 'loading' ||
      !form.name.trim() ||
      !form.email.trim() ||
      !form.subject.trim() ||
      !form.message.trim() ||
      isEmailInvalid ||
      isMessageTooShort;

    const submitButton = formElement.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (submitButton) {
      submitButton.disabled = isSubmitDisabled;
    }
  };

  const handleInputChange = (event: Event) => {
    const target = event.target as HTMLInputElement | HTMLTextAreaElement;
    updateForm(target.name, target.value);
    
    // Handle touched states for email and message
    if (target.name === 'email' && !emailTouched) {
      emailTouched = true;
    }
    if (target.name === 'message' && !messageTouched) {
      messageTouched = true;
    }
    
    // Update status display to show/hide field errors on input
    updateStatusDisplay();
  };

  const handleBlur = (event: Event) => {
    const target = event.target as HTMLInputElement | HTMLTextAreaElement;
    if (target.name === 'email') {
      emailTouched = true;
    }
    if (target.name === 'message') {
      messageTouched = true;
    }
    updateSubmitButton();
    
    // Update status display to show/hide field errors on blur
    updateStatusDisplay();
  };

  const handleSubmit = async (event: Event) => {
    event.preventDefault();
    
    // Mark fields as touched
    emailTouched = true;
    messageTouched = true;
    
    const isEmailInvalid = !validateEmail();
    const isMessageTooShort = !validateMessage();
    
    if (isEmailInvalid) {
      status = 'error';
      feedback = 'Please enter a valid email address.';
      updateStatusDisplay();
      return;
    }

    if (isMessageTooShort) {
      status = 'error';
      feedback = `Message is too short. Please write at least ${MIN_MESSAGE_LENGTH} characters.`;
      updateStatusDisplay();
      return;
    }

    if (!CONTACT_ENDPOINT) {
      status = 'error';
      feedback = 'Contact endpoint is not configured yet. Please try again later.';
      updateStatusDisplay();
      return;
    }

    // Bot traps. A filled hidden field, or a form completed faster than a person
    // can type, is treated as a bot: show the usual success message and send nothing.
    const trapField = document.getElementById('company-website') as HTMLInputElement | null;
    const trapped = (trapField?.value ?? '').trim() !== '' || Date.now() - loadedAt < MIN_FILL_MS;
    if (trapped) {
      status = 'success';
      feedback = 'Message sent successfully. I will get back to you soon.';
      form = INITIAL_FORM;
      emailTouched = false;
      messageTouched = false;
      updateStatusDisplay();
      (document.getElementById('contact-form') as HTMLFormElement | null)?.reset();
      return;
    }

    // Set loading state
    status = 'loading';
    feedback = 'Sending your message...';
    updateStatusDisplay();
    
    try {
      const payload = buildDiscordPayload(form);
      const response = await fetch(CONTACT_ENDPOINT, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(payload),
      });

      if (!response.ok) {
        let errorMessage = '';

        try {
          const data = await response.json();
          errorMessage = typeof data?.error === 'string' ? data.error : '';
        } catch {
          try {
            errorMessage = (await response.text()).trim();
          } catch {
            errorMessage = '';
          }
        }

        throw new Error(errorMessage || `Request failed with status ${response.status}`);
      }

      status = 'success';
      feedback = 'Message sent successfully. I will get back to you soon.';
      form = INITIAL_FORM;
      emailTouched = false;
      messageTouched = false;
      updateStatusDisplay();
      
      // Reset form
      const formElement = document.getElementById('contact-form') as HTMLFormElement | null;
      if (formElement) {
        formElement.reset();
      }
    } catch (error) {
      status = 'error';
      const message = error instanceof Error ? error.message.trim() : '';
      feedback = message || 'Could not send your message right now. Please try again later or email me directly.';
      updateStatusDisplay();
    }
  };

  const updateStatusDisplay = () => {
    const formElement = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!formElement) return;
    
    const statusElement = formElement.querySelector('.form-status') as HTMLElement | null;
    const submitButton = formElement.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    
    if (statusElement) {
      statusElement.textContent = feedback;
      statusElement.className = `form-status ${status === 'error' ? 'error' : status === 'success' ? 'success' : ''}`;
    }
    
    if (submitButton) {
      submitButton.textContent = status === 'loading' ? 'Sending...' : 'Send Message';
    }
    
    // Update error messages
    const emailErrorElement = document.getElementById('email-error') as HTMLElement | null;
    const messageErrorElement = document.getElementById('message-error') as HTMLElement | null;
    
    if (emailErrorElement) {
      // Original logic: show error only when field is touched AND non-empty AND invalid
      const showEmailError = emailTouched && form.email.trim().length > 0 && !EMAIL_REGEX.test(form.email.trim());
      if (showEmailError) {
        emailErrorElement.textContent = 'Please enter a valid email address.';
        emailErrorElement.hidden = false;
        const emailInput = document.getElementById('email') as HTMLInputElement | null;
        if (emailInput) {
          emailInput.setAttribute('aria-invalid', 'true');
          emailInput.setAttribute('aria-describedby', 'email-error');
        }
      } else {
        emailErrorElement.hidden = true;
        const emailInput = document.getElementById('email') as HTMLInputElement | null;
        if (emailInput) {
          emailInput.removeAttribute('aria-invalid');
          emailInput.removeAttribute('aria-describedby');
        }
      }
    }
    
    if (messageErrorElement) {
      // Original logic: show error only when field is touched AND non-empty AND invalid
      const showMessageError = messageTouched && form.message.trim().length > 0 && form.message.trim().length < MIN_MESSAGE_LENGTH;
      if (showMessageError) {
        messageErrorElement.textContent = `Please enter at least ${MIN_MESSAGE_LENGTH} characters in your message.`;
        messageErrorElement.hidden = false;
        const messageInput = document.getElementById('message') as HTMLTextAreaElement | null;
        if (messageInput) {
          messageInput.setAttribute('aria-invalid', 'true');
          messageInput.setAttribute('aria-describedby', 'message-error');
        }
      } else {
        messageErrorElement.hidden = true;
        const messageInput = document.getElementById('message') as HTMLTextAreaElement | null;
        if (messageInput) {
          messageInput.removeAttribute('aria-invalid');
          messageInput.removeAttribute('aria-describedby');
        }
      }
    }
  };

  // Initialize form when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      const formElement = document.getElementById('contact-form') as HTMLFormElement | null;
      if (formElement) {
        formElement.addEventListener('submit', handleSubmit);
        
        // Add event listeners to inputs
        const inputs = formElement.querySelectorAll('input, textarea');
        inputs.forEach(input => {
          input.addEventListener('input', handleInputChange);
          input.addEventListener('blur', handleBlur);
        });
      }
      updateSubmitButton();
    });
  } else {
    // DOM already loaded
    const formElement = document.getElementById('contact-form') as HTMLFormElement | null;
    if (formElement) {
      formElement.addEventListener('submit', handleSubmit);
      
      // Add event listeners to inputs
      const inputs = formElement.querySelectorAll('input, textarea');
      inputs.forEach(input => {
        input.addEventListener('input', handleInputChange);
        input.addEventListener('blur', handleBlur);
      });
    }
    updateSubmitButton();
  }
};

// Execute the initialization function
initContactForm();
</script>